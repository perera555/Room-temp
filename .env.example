# Copy this file to .env.local for local testing, and add the same names
# in Vercel → Project → Settings → Environment Variables for the live site.
# Every setting is optional: anything left empty shows sample data.

# --- General -------------------------------------------------------
LOCATION_NAME=Sri Lanka
# Your town (default Colombo). Google Maps → right-click your place → copy numbers.
LATITUDE=6.9271
LONGITUDE=79.8612
# kmh | mph | ms | kn
WIND_UNIT=kmh

# --- Too hot / too cold alerts ----------------------------------------
ALERT_HOT=32
ALERT_COLD=20
# repeat the phone message every N minutes while a room is still out of range
ALERT_REPEAT_MIN=60
# Phone messages (any or all):
# ntfy: install the ntfy app, subscribe to a secret topic name, put it here
NTFY_TOPIC=
# WhatsApp via CallMeBot: +9477xxxxxxx:APIKEY (comma-separate several numbers)
CALLMEBOT_WHATSAPP=
# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Bill photo reading (📷 Import bill) -------------------------------
# API key from console.anthropic.com (pay as you go). Without it, add bills by hand.
ANTHROPIC_API_KEY=

# --- Gas cylinder (LPG) ----------------------------------------------
GAS_CYLINDER_KG=12.5
# days a cylinder lasts until the app learns it from the "New cylinder fitted" button
GAS_CYLINDER_DAYS=90
# only needed if you don't use the button (needs Upstash): date the current one was fitted
GAS_LAST_CHANGED=
# Optional password lock (recommended: guest names are private)
DASHBOARD_PASSWORD=

# --- Guest bookings (Google Calendar / Airbnb iCal links) -----------
# One or more links, comma separated. Optional "Label|" prefix.
# Google: Calendar settings → Integrate calendar → "Secret address in iCal format"
# Airbnb: Calendar → Availability → Export calendar
CALENDAR_ICAL_URLS=

# Unit 3's double bedrooms are let individually. Label each link with its room:
#   Bedroom 1|https://…ics, Bedroom 2|https://…ics, Bedroom 3|https://…ics
# (or put "Bed 1" in the event title when using one shared calendar)
# Which unit is on Airbnb (default 3):
AIRBNB_UNITS=3

# --- Room sensors ---------------------------------------------------
# Sensors send readings to /api/readings?key=SENSOR_API_KEY (see /guide).
SENSOR_API_KEY=
# Added automatically by Vercel when you connect Upstash Redis (Storage tab):
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternative: one JSON file with every reading
SENSOR_FEED_URL=
SENSOR_FEED_TOKEN=

# --- Energy (Octopus Energy smart meter) -----------------------------
OCTOPUS_API_KEY=
OCTOPUS_ELEC_MPAN=
OCTOPUS_ELEC_SERIAL=
OCTOPUS_GAS_MPRN=
OCTOPUS_GAS_SERIAL=
# set to "kwh" if your gas meter already reports kWh (default m³)
OCTOPUS_GAS_UNITS=
ELEC_RATE_PENCE=24.5
GAS_RATE_PENCE=6.3

# --- Weight (JSON list of {"date": "...", "kg": 76.2}) ----------------
WEIGHT_FEED_URL=
